# Applywise API — environment variables
#
# Copy this file to `.env` and fill in the real values:
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real secrets.
# See ../docs/development.md for how to obtain each value.

# ─── Required ──────────────────────────────────────────────────────────────

# MongoDB Atlas connection string, including the database name.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/applywise

# Secret for signing access tokens. Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-string

# Secret for signing refresh tokens. MUST differ from JWT_SECRET.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Token lifetimes. Accepts any ms-compatible duration ("15m", "7d", "24h").
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin, used as the CORS allowed origin. No trailing slash.
# Exactly one origin is honoured — see ../docs/deployment.md.
CLIENT_URL=http://localhost:3000

PORT=5000
NODE_ENV=development

# ─── Optional ──────────────────────────────────────────────────────────────

# Shared secret for POST /api/internal/run-stale-check. Required only if you
# drive the stale check from an external scheduler (as production does).
INTERNAL_SECRET=

# SMTP. Leave blank to run without email — registration, the stale digest and
# follow-up reminders all degrade quietly rather than failing the request.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Applywise <noreply@example.com>
