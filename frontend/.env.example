# Applywise frontend — environment variables
#
# Copy this file to `.env.local` and adjust if needed:
#   cp .env.example .env.local
#
# `.env.local` is gitignored.

# ─── Required ──────────────────────────────────────────────────────────────

# Base URL of the Applywise API. No trailing slash — `/api` is appended by
# frontend/src/lib/axios.ts, so a trailing slash produces `//api` and 404s.
#
# Local:      http://localhost:5000
# Production: https://apply-wise-htx9.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000
